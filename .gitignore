# Data
# Ignore the contents, not the directory itself: git will not descend into an
# excluded directory, so a negation inside one can never take effect.
data/*
!data/sample/
data/sample/*
!data/sample/*.csv
!data/archive-set.json
!data/archive-manifest.sha256

