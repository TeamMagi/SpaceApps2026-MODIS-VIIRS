# Research & Analysis (local reference only)
reference-projects/
academic-papers/
CHALLENGE_INFO.md
STRATEGY.md

# Rust
target/
**/*.rs.bk
*.pdb

# Node / Frontend
node_modules/
dist/
.vite/
*.tsbuildinfo

# Environment
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db
desktop.ini

# Data
# Ignore the contents, not the directory itself: git will not descend into an
# excluded directory, so a negation inside one can never take effect.
data/*
!data/sample/
data/sample/*
!data/sample/*.csv
!data/sample/README.md
# Per-region demo sets produced by the sample_region example (see data/sample/README.md).
!data/sample/*/
# Derived Turkey case-study files (see data/case-study/turkey/README.md).
!data/case-study/
!data/archive-set.json
!data/archive-manifest.sha256
!data/derived/
# Embedded biome grid (include_bytes! in crates/core/src/biome.rs).
!data/landcover/

# IDE
.idea/
.vscode/
*.swp
*.swo

.claude
nasa.pdf
# FIRMS pre-packaged archive cache (archive_ingest example default)
.cache/

# Frontend test output
.test-out/

# Local pipeline configuration (see pyrosync.example.toml)
pyrosync.toml
academic-papers.zip
