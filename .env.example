# NASA FIRMS API Key (https://firms.modaps.eosdis.nasa.gov/api/area/)
# If unset or blank, the server still boots for health/static checks, but FIRMS endpoints return 500
FIRMS_API_KEY=your_api_key_here

# Server
PORT=3001
RUST_LOG=pyrosync=info

# Frontend build directory (defaults to web/dist locally; Docker Compose sets /app/static)
# Leave commented out when running via Docker so the container uses /app/static
# STATIC_DIR=web/dist

# FIRMS country archive cache directory (defaults to .cache/firms-archive locally; Docker Compose sets /app/.cache/firms-archive)
# ARCHIVE_CACHE_DIR=.cache/firms-archive

# Response cache memory budget in MB (0 disables response caching)
CACHE_BUDGET_MB=128

# Request timeout in seconds (0 disables the timeout)
REQUEST_TIMEOUT_SECS=300

# Comma-separated list of allowed CORS origins (leave unset for permissive CORS)
# CORS_ALLOWED_ORIGINS=http://localhost:5173
