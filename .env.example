# NASA FIRMS API Key (https://firms.modaps.eosdis.nasa.gov/api/area/)
# If unset or blank, the server still boots for health/static checks, but FIRMS endpoints return 500
FIRMS_API_KEY=your_api_key_here

# Server
PORT=3001
RUST_LOG=pyrosync=info

# Frontend build directory (defaults to web/dist locally; Docker Compose sets /app/static)
# Leave commented out when running via Docker so the container uses /app/static
# STATIC_DIR=web/dist

# FIRMS country archive cache directory (defaults to .cache/firms-archive locally; Docker Compose sets /app/.cache/firms-archive)
# ARCHIVE_CACHE_DIR=.cache/firms-archive

# Host directory holding the FIRMS country archive cache.
# Docker bind-mounts this path, so the same bytes serve local development and the container.
# ARCHIVE_CACHE_HOST_DIR=./.cache/firms-archive

# Container user for Docker. The default matches the image user and works on Docker Desktop.
# On Linux set this to your own ids so the container can write to the bind-mounted cache:
#   DOCKER_USER=1000:1000
# DOCKER_USER=999:999

# Response cache memory budget in MB (0 disables response caching)
CACHE_BUDGET_MB=128

# Request timeout in seconds (0 disables the timeout)
REQUEST_TIMEOUT_SECS=300

# On-disk cache of FIRMS Area API windows; a cache hit costs no FIRMS transactions (empty value disables it)
# AREA_CACHE_DIR=.cache/firms-area
# Seconds a cached near-real-time window stays valid (science-quality windows never expire; 0 = never serve NRT from cache)
# AREA_CACHE_NRT_TTL_SECS=600

# Comma-separated list of allowed CORS origins (leave unset for permissive CORS)
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Pipeline configuration (see pyrosync.example.toml). All optional; the defaults reproduce the published behaviour.
# Path to a TOML file; if unset, ./pyrosync.toml is used when it exists
# PYROSYNC_CONFIG=pyrosync.toml
# Environment overrides beat the TOML file:
# PYROSYNC_DEDUP_MAX_TIME_DIFF_SECS=8
# PYROSYNC_DEDUP_MIN_OVERLAP_RATIO=0.30
# PYROSYNC_FLEET_VIIRS_WINDOW_SECS=3600
# PYROSYNC_FLEET_MODIS_WINDOW_SECS=10800
# PYROSYNC_FLEET_RADIUS_KM=2.0
# PYROSYNC_MATCH_RADIUS_KM=2.0
# PYROSYNC_MATCH_WINDOW_SECS=10800
# PYROSYNC_VZA_A=0.2017
# PYROSYNC_VZA_B=0.0168
# PYROSYNC_VZA_C=1.0
